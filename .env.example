# ── Database (required) ─────────────────────────────────────────────────────
# Neon: use the POOLED connection string (host contains "-pooler"), region Frankfurt.
# For a local Postgres instead: postgres://user:pass@localhost:5432/woona
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Your site's address, used in tracking links, invite links and emails.
# On Vercel, set it to the live URL (e.g. https://wo-ona.vercel.app).
APP_URL=http://localhost:3000

# ── Live updates with Pusher Channels (optional, recommended) ───────────────
# Without these, every page still works by checking the server every few seconds.
# NEXT_PUBLIC_ values are built into the browser code: after changing them on
# Vercel, redeploy.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
PUSHER_APP_ID=
PUSHER_SECRET=

# ── Proof-of-delivery photos with Vercel Blob (optional) ────────────────────
# When set, riders must photograph the parcel at the door before confirming.
# Vercel adds this automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# ── Email with Resend (optional) ────────────────────────────────────────────
# Empty = emails are printed in the terminal instead. Until you verify a
# domain, EMAIL_FROM must use onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=Wo Ọ̀nà <onboarding@resend.dev>

# ── Demo and housekeeping ───────────────────────────────────────────────────
# "true" lets ANY rider use "Simulate ride" (handy for a portfolio). Demo
# accounts can always simulate. For a real fleet, set it to "false".
ALLOW_SIMULATED_TRIPS=true
# Any long random string. Vercel Cron sends it to /api/cron/cleanup.
CRON_SECRET=replace-with-a-long-random-string

# Passwords for the seeded accounts (npm run db:seed). At least 8 characters.
SEED_USER_PASSWORD=change-me-please
SEED_ADMIN_PASSWORD=change-me-too-please
